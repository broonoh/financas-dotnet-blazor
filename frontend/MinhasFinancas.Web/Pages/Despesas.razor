        </MudItem>
        <MudItem xs="12" md="4">
            @if (_categoriasDespesa?.Count > 0)
            {
                <MudSelect T="string" @bind-Value="_extraCategoria" Label="Categoria" Variant="Variant.Outlined" FullWidth="true">
                    @foreach (var cat in _categoriasDespesa)
                    {
                        <MudSelectItem Value="@cat.Nome">@cat.Nome</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudTextField @bind-Value="_extraCategoria" Label="Categoria" Variant="Variant.Outlined" FullWidth="true"
                              Placeholder="Nenhuma categoria. Cadastre em Categorias > Despesa" />
            }
        </MudItem>
        <MudItem xs="12" md="5">
            <MudSelect T="string" @bind-Value="_extraFormaPagamento" Label="Forma de Pagamento" Variant="Variant.Outlined" FullWidth="true">
                <MudSelectItem Value="@("CartaoCredito")">Cartão de Crédito</MudSelectItem>
                <MudSelectItem Value="@("Pix")">Pix</MudSelectItem>
                <MudSelectItem Value="@("Dinheiro")">Dinheiro</MudSelectItem>
                <MudSelectItem Value="@("Boleto")">Boleto</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudDatePicker @bind-Date="_extraPagaEm" Label="Vencimento"
                           Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Editable="true" PickerVariant="PickerVariant.Dialog" Clearable="true" />
        </MudItem>
        <MudItem xs="12">
            @if (!string.IsNullOrEmpty(_extraErro)) { <MudAlert Severity="Severity.Error" Class="mb-2">@_extraErro</MudAlert> }
            <MudButton Color="Color.Warning" Variant="Variant.Filled"
                       OnClick="@(editando ? AtualizarExtra : SalvarExtra)" Disabled="_extraSalvando">
                @if (_extraSalvando) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                @(editando ? "Atualizar" : "Salvar")
            </MudButton>
            <MudButton Class="ml-2" OnClick="CancelarExtra">Cancelar</MudButton>
        </MudItem>
    </MudGrid>;
}

@code {
    private int _activeTab;

    // Filtro de período compartilhado entre as abas
    private int _filtroMes;
    private int _filtroAno;
    private int _filtroMesAplicado;
    private int _filtroAnoAplicado;
    private int[] _anosOpcoes = [];
    private readonly (int Num, string Nome)[] _meses =
    [
        (1, "Janeiro"), (2, "Fevereiro"), (3, "Março"), (4, "Abril"),
        (5, "Maio"), (6, "Junho"), (7, "Julho"), (8, "Agosto"),
        (9, "Setembro"), (10, "Outubro"), (11, "Novembro"), (12, "Dezembro")
    ];

    // Categorias
    private List<CategoriaDto>? _categoriasDespesa;

    // Despesas Fixas
    private List<DespesaFixaListDto>? _despesasFixas;
    private bool _carregandoFixas = true;
    private bool _mostrarFormFixa;
    private bool _fixaSalvando;
    private string _fixaErro = string.Empty;
    private Guid? _excluindoFixaId;
    private Guid? _editandoFixaId;
    private Guid? _expandedFixaId;
    private bool _baixandoFixasPdf;
    private string _fixaDescricao = string.Empty;
    private string _fixaValorStr = string.Empty;
    private string _fixaParcelas = "2";
    private DateTime? _fixaDataCompra;
    private DateTime? _fixaDataPrimeiraParcela;
    private string _fixaCategoria = "Outros";
    private string _fixaFormaPagamento = "CartaoCredito";

    // Despesas Extras
    private List<DespesaExtraListDto>? _despesasExtras;
    private bool _carregandoExtras = true;
    private bool _mostrarFormExtra;
    private bool _extraSalvando;
    private string _extraErro = string.Empty;
    private Guid? _excluindoExtraId;
    private Guid? _editandoExtraId;
    private bool _baixandoExtrasPdf;
    private Guid? _expandedExtraId;
    private string _extraDescricao = string.Empty;
    private string _extraValorStr = string.Empty;
    private DateTime? _extraDataDespesa;
    private DateTime? _extraPagaEm;
    private string _extraCategoria = "Outros";
    private string _extraFormaPagamento = "CartaoCredito";

    // Cultura pt-BR reutilizada no template
    private readonly System.Globalization.CultureInfo _ptBR = new("pt-BR");

    // Dívidas
    private List<DividaDto>? _dividas;
    private List<GrupoDivida> _gruposDividas = [];
    private string _devedorSelecionado = "";
    private GrupoDivida? GrupoAtivo =>
        _gruposDividas.FirstOrDefault(g => g.Nome == _devedorSelecionado)
        ?? _gruposDividas.FirstOrDefault();
    private bool _carregandoDividas = true;
    private bool _mostrarFormDivida;
    private bool _dividaSalvando;
    private string _dividaErro = string.Empty;
    private Guid? _excluindoDividaId;
    private Guid? _expandedDividaId;
    private Guid? _editandoDividaId;
    private string _dividaNomeDevedor = string.Empty;
    private string _dividaDescricao = string.Empty;
    private string _dividaValorStr = string.Empty;
    private string _dividaParcelasStr = "1";
    private DateTime? _dividaDataCompra;
    private DateTime? _dividaDataPrimeiraParcela;

    private record GrupoDivida(
        string Nome,
        List<DividaDto> Dividas,
        decimal Total,
        decimal Saldo,
        bool TemVencida,
        decimal ValorMes,
        string LabelMes,
        ParcelaDividaDto? ProximaParc
    );

    protected override void OnInitialized()
    {
        var hoje = DateTime.Now;
        _filtroMes = hoje.Month;
        _filtroAno = hoje.Year;
        _filtroMesAplicado = hoje.Month;
        _filtroAnoAplicado = hoje.Year;
        _anosOpcoes = Enumerable.Range(hoje.Year - 3, 7).ToArray();
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CarregarFixas(), CarregarExtras(), CarregarDividas(), CarregarCategorias());
    }

    private async Task BuscarFixas()
    {
        _filtroMesAplicado = _filtroMes;
        _filtroAnoAplicado = _filtroAno;
        await CarregarFixas();
    }

    private async Task BuscarExtras()
    {
        _filtroMesAplicado = _filtroMes;
        _filtroAnoAplicado = _filtroAno;
        await CarregarExtras();
    }

    private async Task BuscarDividas()
    {
        _filtroMesAplicado = _filtroMes;
        _filtroAnoAplicado = _filtroAno;
        await CarregarDividas();
    }

    private async Task CarregarCategorias()
    {
        _categoriasDespesa = await ApiService.ListarCategoriasDespesaAsync() ?? [];
        if (_fixaCategoria == "Outros" && _categoriasDespesa.Count > 0)
            _fixaCategoria = _categoriasDespesa[0].Nome;
        if (_extraCategoria == "Outros" && _categoriasDespesa.Count > 0)
            _extraCategoria = _categoriasDespesa[0].Nome;
    }

    private async Task CarregarFixas()
    {
        _carregandoFixas = true;
        try { _despesasFixas = await ApiService.ListarDespesasFixasAsync() ?? []; }
        catch { _despesasFixas = []; }
        _carregandoFixas = false;
    }

    private async Task CarregarExtras()
    {
        _carregandoExtras = true;
        try { _despesasExtras = await ApiService.ListarDespesasExtrasAsync() ?? []; }
        catch { _despesasExtras = []; }
        _carregandoExtras = false;
    }

    private async Task CarregarDividas()
    {
        _carregandoDividas = true;
        try
        {
            _dividas = await ApiService.ListarDividasAsync() ?? [];
            ProcessarGruposDividas();
        }
        catch { _dividas = []; _gruposDividas = []; }
        _carregandoDividas = false;
    }

    private void ProcessarGruposDividas()
    {
        if (_dividas == null || _dividas.Count == 0) { _gruposDividas = []; return; }
        var hoje = DateOnly.FromDateTime(DateTime.Now);
        _gruposDividas = _dividas
            .GroupBy(d => d.NomeDevedor.Trim(), StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g.Key)
            .Select(g =>
            {
                var dividas = g.Where(d => (d.Parcelas ?? []).Any(p => p.DataVencimento.Year == _filtroAnoAplicado && p.DataVencimento.Month == _filtroMesAplicado)).ToList();
                var todasParc = dividas.SelectMany(d => d.Parcelas ?? []).ToList();
                var valorMes = todasParc
                    .Where(p => p.DataVencimento.Year == _filtroAnoAplicado && p.DataVencimento.Month == _filtroMesAplicado)
                    .Sum(p => p.Valor);
                var labelMes = (_filtroAnoAplicado != hoje.Year || _filtroMesAplicado != hoje.Month)
                    ? $"A pagar ({new DateOnly(_filtroAnoAplicado, _filtroMesAplicado, 1).ToString("MMM/yy", _ptBR)})"
                    : "Este mês (a pagar)";
                return new GrupoDivida(
                    Nome: g.Key,
                    Dividas: dividas,
                    Total: dividas.Sum(d => d.ValorTotal),
                    Saldo: dividas.Sum(d => d.SaldoRestante),
                    TemVencida: dividas.Any(d => d.Parcelas.Any(p => p.Vencida && !p.Paga)),
                    ValorMes: valorMes,
                    LabelMes: labelMes,
                    ProximaParc: todasParc.Where(p => !p.Paga).OrderBy(p => p.DataVencimento).FirstOrDefault()
                );
            })
            .Where(g => g.Dividas.Count > 0)
            .ToList();

        if (!_gruposDividas.Any(g => g.Nome == _devedorSelecionado))
            _devedorSelecionado = _gruposDividas.FirstOrDefault()?.Nome ?? "";
    }

    private void SelecionarDevedor(string nome)
    {
        _devedorSelecionado = nome;
        _expandedDividaId = null;
    }

