    private async Task DownloadPdf(string nomeDevedor)
    {
        try
        {
            var bytes = await ApiService.DownloadDividasPdfAsync(nomeDevedor, _filtroMesAplicado, _filtroAnoAplicado);
            if (bytes is null || bytes.Length == 0) { Snackbar.Add("Nenhuma dívida encontrada para este período.", Severity.Warning); return; }
            var fileName = $"dividas_{nomeDevedor.Replace(" ", "_")}_{_filtroMesAplicado:D2}_{_filtroAnoAplicado}.pdf";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "application/pdf", Convert.ToBase64String(bytes));
        }
        catch { Snackbar.Add("Erro ao baixar PDF.", Severity.Error); }
    }

    private async Task DownloadFixasPdf()
    {
        _baixandoFixasPdf = true;
        try
        {
            var (bytes, error) = await ApiService.DownloadDespesasFixasPdfAsync(_filtroMesAplicado, _filtroAnoAplicado);
            if (bytes is null || bytes.Length == 0)
            {
                var msg = TryExtractMessage(error) ?? "Nenhuma despesa fixa encontrada para este período.";
                Snackbar.Add(msg, Severity.Warning);
                return;
            }
            var nomeMes = _meses.First(m => m.Num == _filtroMesAplicado).Nome.ToLower();
            await JS.InvokeVoidAsync("downloadFileFromBytes", $"despesas_fixas_{nomeMes}_{_filtroAnoAplicado}.pdf", "application/pdf", Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { Snackbar.Add($"Erro ao baixar PDF: {ex.Message}", Severity.Error); }
        finally { _baixandoFixasPdf = false; }
    }

    private async Task DownloadExtrasPdf()
    {
        _baixandoExtrasPdf = true;
        try
        {
            var bytes = await ApiService.DownloadDespesasExtrasPdfAsync(_filtroMesAplicado, _filtroAnoAplicado);
            if (bytes is null || bytes.Length == 0) { Snackbar.Add("Nenhuma despesa extra encontrada para este período.", Severity.Warning); return; }
            var nomeMes = _meses.First(m => m.Num == _filtroMesAplicado).Nome.ToLower();
            await JS.InvokeVoidAsync("downloadFileFromBytes", $"despesas_extras_{nomeMes}_{_filtroAnoAplicado}.pdf", "application/pdf", Convert.ToBase64String(bytes));
        }
        catch { Snackbar.Add("Erro ao baixar PDF.", Severity.Error); }
        finally { _baixandoExtrasPdf = false; }
    }

    private static string? TryExtractMessage(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("message", out var m)) return m.GetString();
        }
        catch { }
        return json?.Length > 200 ? json[..200] + "…" : json;
    }
