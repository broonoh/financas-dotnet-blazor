@page "/despesas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using MinhasFinancas.Web.Services
@using MinhasFinancas.Web.Models
@inject DashboardApiService ApiService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Despesas</MudText>

<MudPaper Elevation="2" Class="mb-2">
    <div class="d-flex">
        <MudButton FullWidth="true" Variant="@(_activeTab == 0 ? Variant.Filled : Variant.Text)" Color="@(_activeTab == 0 ? Color.Primary : Color.Default)" OnClick="@(() => _activeTab = 0)">Despesas Fixas</MudButton>
        <MudButton FullWidth="true" Variant="@(_activeTab == 1 ? Variant.Filled : Variant.Text)" Color="@(_activeTab == 1 ? Color.Warning : Color.Default)" OnClick="@(() => _activeTab = 1)">Despesas Extras</MudButton>
        <MudButton FullWidth="true" Variant="@(_activeTab == 2 ? Variant.Filled : Variant.Text)" Color="@(_activeTab == 2 ? Color.Error : Color.Default)" OnClick="@(() => _activeTab = 2)">Contas a Receber</MudButton>
    </div>
</MudPaper>

@if (_activeTab == 0)
{
    <!-- ABA: DESPESA FIXA -->
    <MudPaper Elevation="0" Class="pa-4">
            <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary"
                       Variant="Variant.Filled" OnClick="@(() => { _mostrarFormFixa = !_mostrarFormFixa; _editandoFixaId = null; })" Class="mb-4">
                Nova Despesa Fixa
            </MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Secondary"
                       Variant="Variant.Outlined" OnClick="DownloadFixasPdf" Disabled="_baixandoFixasPdf" Class="mb-4 ml-2">
                @if (_baixandoFixasPdf) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
                Exportar PDF
            </MudButton>

            @if (_mostrarFormFixa && _editandoFixaId == null)
            {
                <MudPaper Elevation="1" Class="pa-4 mb-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Nova Despesa Fixa</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_fixaDescricao" Label="Descrição" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudTextField @bind-Value="_fixaValorStr" Label="Valor Total (R$)" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudTextField @bind-Value="_fixaParcelas" Label="Nº de Parcelas" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudDatePicker @bind-Date="_fixaDataCompra" Label="Data da Compra"
                                           Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Editable="true" PickerVariant="PickerVariant.Dialog" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudDatePicker @bind-Date="_fixaDataPrimeiraParcela" Label="Vencimento 1ª Parcela"
                                           Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Editable="true" PickerVariant="PickerVariant.Dialog" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            @if (_categoriasDespesa?.Count > 0)
                            {
                                <MudSelect T="string" @bind-Value="_fixaCategoria" Label="Categoria" Variant="Variant.Outlined" FullWidth="true">
                                    @foreach (var cat in _categoriasDespesa)
                                    {
                                        <MudSelectItem Value="@cat.Nome">@cat.Nome</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                <MudTextField @bind-Value="_fixaCategoria" Label="Categoria" Variant="Variant.Outlined" FullWidth="true"
                                              Placeholder="Nenhuma categoria. Cadastre em Categorias > Despesa" />
                            }
                        </MudItem>
                        <MudItem xs="12" md="5">
                            <MudSelect T="string" @bind-Value="_fixaFormaPagamento" Label="Forma de Pagamento" Variant="Variant.Outlined" FullWidth="true">
                                <MudSelectItem Value="@("CartaoCredito")">Cartão de Crédito</MudSelectItem>
                                <MudSelectItem Value="@("PixParcelado")">Pix Parcelado</MudSelectItem>
                                <MudSelectItem Value="@("BoletoParcelado")">Boleto Parcelado</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            @if (!string.IsNullOrEmpty(_fixaErro)) { <MudAlert Severity="Severity.Error" Class="mb-2">@_fixaErro</MudAlert> }
                            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SalvarFixa" Disabled="_fixaSalvando">
                                @if (_fixaSalvando) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                                Salvar
                            </MudButton>
                            <MudButton Class="ml-2" OnClick="CancelarFixa">Cancelar</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }

            @if (_carregandoFixas)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            <MudPaper Elevation="0" Class="pa-3 mb-3" Style="background:var(--mud-palette-background-grey);border-radius:8px;">
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mr-1">Período:</MudText>
                    <MudSelect T="int" @bind-Value="_filtroMes" Label="Mês" Variant="Variant.Outlined" Dense="true" Style="min-width:130px;">
                        @foreach (var (num, nome) in _meses)
                        {
                            <MudSelectItem Value="@num">@nome</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="int" @bind-Value="_filtroAno" Label="Ano" Variant="Variant.Outlined" Dense="true" Style="min-width:90px;">
                        @foreach (var ano in _anosOpcoes)
                        {
                            <MudSelectItem Value="@ano">@ano</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton StartIcon="@Icons.Material.Filled.Search" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" OnClick="BuscarFixas" Disabled="_carregandoFixas">
                        Buscar
                    </MudButton>
                </div>
            </MudPaper>
            @if (_despesasFixas?.Count > 0)
            {
                var _fixasDoMes = _despesasFixas.Where(d => (d.Parcelas ?? []).Any(p => p.DataVencimento.Year == _filtroAnoAplicado && p.DataVencimento.Month == _filtroMesAplicado)).ToList();
                var _todasParc = _fixasDoMes.SelectMany(d => d.Parcelas ?? []).ToList();
                var _parcsDoMes = _todasParc.Where(p => p.DataVencimento.Year == _filtroAnoAplicado && p.DataVencimento.Month == _filtroMesAplicado).ToList();
                var _totMes = _parcsDoMes.Sum(p => p.Valor);
                var _totPagoMes = _parcsDoMes.Where(p => p.Paga).Sum(p => p.Valor);
                var _saldoMes = _totMes - _totPagoMes;
                var _totVenc = _todasParc.Where(p => p.Vencida && !p.Paga).Sum(p => p.Valor);
                <MudPaper Elevation="0" Class="pa-3 mb-4" Style="background:var(--mud-palette-background-grey);border-radius:8px;">
                    <MudGrid>
                        <MudItem xs="12" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">A pagar este mês</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Primary"><strong>@_totMes.ToString("C2", _ptBR)</strong></MudText>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Saldo Restante</MudText>
                            <MudText Typo="Typo.h6" Color="@(_saldoMes > 0 ? Color.Warning : Color.Success)"><strong>@_saldoMes.ToString("C2", _ptBR)</strong></MudText>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Em atraso</MudText>
                            <MudText Typo="Typo.h6" Color="@(_totVenc > 0 ? Color.Error : Color.Success)"><strong>@_totVenc.ToString("C2", _ptBR)</strong></MudText>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Despesas ativas</MudText>
                            <MudText Typo="Typo.h6"><strong>@_fixasDoMes.Count</strong></MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                @foreach (var fixа in _fixasDoMes)
                {
                    var parcelasPagas = (fixа.Parcelas ?? []).Count(p => p.Paga);
                    var totalParcelas = fixа.QuantidadeParcelas;
                    var progressoPercent = totalParcelas > 0 ? (double)parcelasPagas / totalParcelas * 100 : 0;
                    var saldoRestante = (fixа.Parcelas ?? []).Where(p => !p.Paga).Sum(p => p.Valor);
                    var temVencida = (fixа.Parcelas ?? []).Any(p => p.Vencida && !p.Paga);
                    var expandida = _expandedFixaId == fixа.Id;

                    <MudCard Class="mb-3" Elevation="2">
                        <MudCardHeader>
                            <CardHeaderContent>
                                @if (_editandoFixaId == fixа.Id)
                                {
                                    <MudGrid>
                                        <MudItem xs="12" md="6">
                                            <MudTextField @bind-Value="_fixaDescricao" Label="Descrição" Variant="Variant.Outlined" FullWidth="true" />
                                        </MudItem>
                                        <MudItem xs="12" md="3">
                                            <MudTextField @bind-Value="_fixaValorStr" Label="Valor Total (R$)" Variant="Variant.Outlined" FullWidth="true" />
                                        </MudItem>
                                        <MudItem xs="12" md="3">
                                            <MudTextField @bind-Value="_fixaParcelas" Label="Nº de Parcelas" Variant="Variant.Outlined" FullWidth="true" />
                                        </MudItem>
                                        <MudItem xs="12" md="3">
                                            <MudDatePicker @bind-Date="_fixaDataCompra" Label="Data da Compra"
                                                           Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Editable="true" PickerVariant="PickerVariant.Dialog" />
                                        </MudItem>
                                        <MudItem xs="12" md="3">
                                            <MudDatePicker @bind-Date="_fixaDataPrimeiraParcela" Label="Vencimento 1ª Parcela"
                                                           Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Editable="true" PickerVariant="PickerVariant.Dialog" />
                                        </MudItem>
                                        <MudItem xs="12" md="3">
                                            @if (_categoriasDespesa?.Count > 0)
                                            {
                                                <MudSelect T="string" @bind-Value="_fixaCategoria" Label="Categoria" Variant="Variant.Outlined" FullWidth="true">
                                                    @foreach (var cat in _categoriasDespesa)
                                                    {
                                                        <MudSelectItem Value="@cat.Nome">@cat.Nome</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            }
                                            else
                                            {
                                                <MudTextField @bind-Value="_fixaCategoria" Label="Categoria" Variant="Variant.Outlined" FullWidth="true" />
                                            }
                                        </MudItem>
                                        <MudItem xs="12" md="3">
                                            <MudSelect T="string" @bind-Value="_fixaFormaPagamento" Label="Forma de Pagamento" Variant="Variant.Outlined" FullWidth="true">
                                                <MudSelectItem Value="@("CartaoCredito")">Cartão de Crédito</MudSelectItem>
                                                <MudSelectItem Value="@("PixParcelado")">Pix Parcelado</MudSelectItem>
                                                <MudSelectItem Value="@("BoletoParcelado")">Boleto Parcelado</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12">
                                            @if (!string.IsNullOrEmpty(_fixaErro)) { <MudAlert Severity="Severity.Error" Class="mb-2">@_fixaErro</MudAlert> }
                                            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AtualizarFixa" Disabled="_fixaSalvando">
                                                @if (_fixaSalvando) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                                                Atualizar
                                            </MudButton>
                                            <MudButton Class="ml-2" OnClick="CancelarFixa">Cancelar</MudButton>
                                        </MudItem>
                                    </MudGrid>
                                }
                                else
                                {
                                    <div class="d-flex align-center justify-space-between">
                                        <div>
                                            <MudText Typo="Typo.subtitle1">
                                                <strong>@fixа.Descricao</strong>
                                                @if (temVencida)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" Class="ml-1" Title="Parcelas vencidas" />
                                                }
                                            </MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @fixа.Categoria &bull; 1ª parcela: @fixа.DataPrimeiraParcela.ToString("dd/MM/yyyy")
                                            </MudText>
                                        </div>
                                        <div class="d-flex align-center gap-2">
                                            <div class="text-right">
                                                <MudText Typo="Typo.body2">
                                                    Total: <strong>@fixа.ValorTotal.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</strong>
                                                </MudText>
                                                <MudText Typo="Typo.body2" Color="@(saldoRestante > 0 ? Color.Error : Color.Success)">
                                                    Saldo: @saldoRestante.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))
                                                </MudText>
                                            </div>
                                            <MudIconButton Icon="@(expandida ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                           OnClick="@(() => _expandedFixaId = expandida ? null : fixа.Id)" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                                           OnClick="@(() => IniciarEdicaoFixa(fixа))" Title="Editar" />
                                            @if (_excluindoFixaId == fixа.Id)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                            }
                                            else
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                               OnClick="@(() => ExcluirFixa(fixа.Id))" Title="Excluir" />
                                            }
                                        </div>
                                    </div>
                                    <MudProgressLinear Color="Color.Primary" Value="@progressoPercent" Class="mt-2" />
                                    <MudText Typo="Typo.caption">@parcelasPagas / @totalParcelas parcelas pagas</MudText>
                                }
                            </CardHeaderContent>
                        </MudCardHeader>

                        @if (expandida && _editandoFixaId != fixа.Id)
                        {
                            <MudCardContent>
                                <MudSimpleTable Dense="true" Hover="true" Style="overflow-x:auto;">
                                    <thead>
                                        <tr>
                                            <th>Parcela</th>
                                            <th>Valor</th>
                                            <th>Vencimento</th>
                                            <th>Status</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in fixа.Parcelas ?? [])
                                        {
                                            <tr>
                                                <td>@p.Numero / @p.TotalParcelas</td>
                                                <td>@p.Valor.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</td>
                                                <td style="color:@(p.Vencida ? "var(--mud-palette-error)" : "inherit")">
                                                    @p.DataVencimento.ToString("dd/MM/yyyy")
                                                    @if (p.Vencida) { <span> (vencida)</span> }
                                                </td>
                                                <td>
                                                    @if (p.Paga)
                                                    {
                                                        <span style="background:#4caf50;color:#fff;padding:2px 10px;border-radius:12px;font-size:0.78rem;">Paga</span>
                                                    }
                                                    else
                                                    {
                                                        <span style="background:@(p.Vencida ? "#f44336" : "#9e9e9e");color:#fff;padding:2px 10px;border-radius:12px;font-size:0.78rem;">Pendente</span>
                                                    }
                                                </td>
                                                <td>
                                                    <MudButton Size="Size.Small"
                                                               Color="@(p.Paga ? Color.Default : Color.Success)"
                                                               Variant="Variant.Outlined"
                                                               OnClick="@(() => ToggleParcelaFixa(p.Id, !p.Paga, fixа.Id))">
                                                        @(p.Paga ? "Desfazer" : "Marcar Paga")
                                                    </MudButton>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            </MudCardContent>
                        }
                    </MudCard>
                }
            }
            else if (!_carregandoFixas)
            {
                <MudAlert Severity="Severity.Info">Nenhuma despesa fixa com vencimento em @_meses.First(m => m.Num == _filtroMesAplicado).Nome/@_filtroAnoAplicado.</MudAlert>
            }
        </MudPaper>
}
else if (_activeTab == 1)
{
    <!-- ABA: DESPESA EXTRA -->
    <MudPaper Elevation="0" Class="pa-4">
            <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Warning"
                       Variant="Variant.Filled" OnClick="@(() => { _mostrarFormExtra = !_mostrarFormExtra; _editandoExtraId = null; })" Class="mb-4">
                Nova Despesa Extra
            </MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Secondary"
                       Variant="Variant.Outlined" OnClick="DownloadExtrasPdf" Disabled="_baixandoExtrasPdf" Class="mb-4 ml-2">
                @if (_baixandoExtrasPdf) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
                Exportar PDF
            </MudButton>

            @if (_mostrarFormExtra && _editandoExtraId == null)
            {
                <MudPaper Elevation="1" Class="pa-4 mb-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Nova Despesa Extra</MudText>
                    @FormExtra(false)
                </MudPaper>
            }

            @if (_carregandoExtras)
            {
                <MudProgressLinear Color="Color.Warning" Indeterminate="true" />
            }
            <MudPaper Elevation="0" Class="pa-3 mb-3" Style="background:var(--mud-palette-background-grey);border-radius:8px;">
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mr-1">Período:</MudText>
                    <MudSelect T="int" @bind-Value="_filtroMes" Label="Mês" Variant="Variant.Outlined" Dense="true" Style="min-width:130px;">
                        @foreach (var (num, nome) in _meses)
                        {
                            <MudSelectItem Value="@num">@nome</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="int" @bind-Value="_filtroAno" Label="Ano" Variant="Variant.Outlined" Dense="true" Style="min-width:90px;">
                        @foreach (var ano in _anosOpcoes)
                        {
                            <MudSelectItem Value="@ano">@ano</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton StartIcon="@Icons.Material.Filled.Search" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Medium" OnClick="BuscarExtras" Disabled="_carregandoExtras">
                        Buscar
                    </MudButton>
                </div>
            </MudPaper>
            @{
                var _extrasDoMes = (_despesasExtras ?? [])
                    .Where(e => { var dt = e.PagaEm ?? e.DataDespesa; return dt.Year == _filtroAnoAplicado && dt.Month == _filtroMesAplicado; })
                    .ToList();
            }
            @if (!_carregandoExtras && _extrasDoMes.Count > 0)
            {
                var _totExtras = _extrasDoMes.Sum(e => e.Valor);
                var _totPagoExtras = _extrasDoMes.Where(e => e.Paga).Sum(e => e.Valor);
                var _saldoExtras = _totExtras - _totPagoExtras;
                <MudPaper Elevation="0" Class="pa-3 mb-4" Style="background:var(--mud-palette-background-grey);border-radius:8px;">
                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Total do mês</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Warning"><strong>@_totExtras.ToString("C2", _ptBR)</strong></MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Saldo Restante</MudText>
                            <MudText Typo="Typo.h6" Color="@(_saldoExtras > 0 ? Color.Warning : Color.Success)"><strong>@_saldoExtras.ToString("C2", _ptBR)</strong></MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Já pago</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Success"><strong>@_totPagoExtras.ToString("C2", _ptBR)</strong></MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
                @foreach (var extra in _extrasDoMes)
                {
                    var expandida = _expandedExtraId == extra.Id;

                    <MudCard Class="mb-3" Elevation="2">
                        <MudCardHeader>
                            <CardHeaderContent>
                                @if (_editandoExtraId == extra.Id)
                                {
                                    @FormExtra(true)
                                }
                                else
                                {
                                    <div class="d-flex align-center justify-space-between">
                                        <div>
                                            <MudText Typo="Typo.subtitle1">
                                                <strong>@extra.Descricao</strong>
                                            </MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @extra.Categoria &bull; @extra.DataDespesa.ToString("dd/MM/yyyy")
                                                @if (extra.PagaEm.HasValue) { <span> &bull; Pgto: @extra.PagaEm.Value.ToString("dd/MM/yyyy")</span> }
                                            </MudText>
                                        </div>
                                        <div class="d-flex align-center gap-2">
                                            <div class="text-right">
                                                <MudText Typo="Typo.body2">
                                                    Valor: <strong>@extra.Valor.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</strong>
                                                </MudText>
                                                <MudText Typo="Typo.body2" Color="@(extra.Paga ? Color.Success : Color.Warning)">
                                                    @(extra.Paga ? "Paga" : "Pendente")
                                                </MudText>
                                            </div>
                                            <MudIconButton Icon="@(expandida ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                           OnClick="@(() => _expandedExtraId = expandida ? null : extra.Id)" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                                           OnClick="@(() => IniciarEdicaoExtra(extra))" Title="Editar" />
                                            @if (_excluindoExtraId == extra.Id)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                            }
                                            else
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                               OnClick="@(() => ExcluirExtra(extra.Id))" Title="Excluir" />
                                            }
                                        </div>
                                    </div>
                                }
                            </CardHeaderContent>
                        </MudCardHeader>

                        @if (expandida && _editandoExtraId != extra.Id)
                        {
                            var extraId = extra.Id;
                            var extraPaga = extra.Paga;
                            <MudCardContent>
                                <MudSimpleTable Dense="true" Hover="true">
                                    <thead>
                                        <tr>
                                            <th>Forma de Pagamento</th>
                                            <th>Vencimento</th>
                                            <th>Status</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>@extra.FormaPagamento</td>
                                            <td>@(extra.PagaEm.HasValue ? extra.PagaEm.Value.ToString("dd/MM/yyyy") : "—")</td>
                                            <td>
                                                @if (extra.Paga)
                                                {
                                                    <span style="background:#4caf50;color:#fff;padding:2px 10px;border-radius:12px;font-size:0.78rem;">Paga</span>
                                                }
                                                else
                                                {
