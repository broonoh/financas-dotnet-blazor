@page "/resumo-mensal"
@using MinhasFinancas.Web.Models
@using MinhasFinancas.Web.Services
@inject DashboardApiService Api
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Resumo Mensal</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Resumo Mensal</MudText>

@* Seletor de período *@
<MudPaper Class="pa-4 mb-5" Elevation="1">
    <MudGrid AlignItems="Center">
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="int" Label="Mês" @bind-Value="_mes" Variant="Variant.Outlined" Dense="true">
                @foreach (var (num, nome) in _meses)
                {
                    <MudSelectItem Value="@num">@nome</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="int" Label="Ano" @bind-Value="_ano" Variant="Variant.Outlined" Dense="true">
                @foreach (var ano in _anos)
                {
                    <MudSelectItem Value="@ano">@ano</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="Carregar" FullWidth="true">
                Buscar
            </MudButton>
        </MudItem>
        @if (_resumo is not null)
        {
            <MudItem xs="12" sm="4" md="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           OnClick="DownloadPdf" Disabled="_baixandoPdf" FullWidth="true">
                    @if (_baixandoPdf)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    }
                    PDF
                </MudButton>
            </MudItem>
        }
    </MudGrid>
</MudPaper>

@if (_carregando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_resumo is null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        Selecione o período e clique em Buscar.
    </MudAlert>
}
else
{
    @* Cards de totais *@
    <MudGrid Class="mb-5">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2" Style="border-left: 4px solid #f44336;">
                <MudText Typo="Typo.caption" Color="Color.Default">Despesas Fixas</MudText>
                <MudText Typo="Typo.h5" Style="color:#f44336; font-weight:700;">
                    @_resumo.TotalDespesasFixas.ToString("C2", _ptBR)
                </MudText>
                <MudText Typo="Typo.caption">@_resumo.DespesasFixas.Count parcela(s)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2" Style="border-left: 4px solid #ff9800;">
                <MudText Typo="Typo.caption" Color="Color.Default">Despesas Extras</MudText>
                <MudText Typo="Typo.h5" Style="color:#ff9800; font-weight:700;">
                    @_resumo.TotalDespesasExtras.ToString("C2", _ptBR)
                </MudText>
                <MudText Typo="Typo.caption">@_resumo.DespesasExtras.Count lançamento(s)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2" Style="border-left: 4px solid #9c27b0;">
                <MudText Typo="Typo.caption" Color="Color.Default">Total Saídas</MudText>
                <MudText Typo="Typo.h5" Style="color:#9c27b0; font-weight:700;">
                    @((_resumo.TotalDespesasFixas + _resumo.TotalDespesasExtras).ToString("C2", _ptBR))
                </MudText>
                <MudText Typo="Typo.caption">fixas + extras</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2" Style="border-left: 4px solid #e91e63;">
                <MudText Typo="Typo.caption" Color="Color.Default">A Quitar</MudText>
                <MudText Typo="Typo.h5" Style="color:#e91e63; font-weight:700;">
                    @TotalAQuitar.ToString("C2", _ptBR)
                </MudText>
                <MudText Typo="Typo.caption">saídas ainda não pagas</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2" Style="border-left: 4px solid #4caf50;">
                <MudText Typo="Typo.caption" Color="Color.Default">Receitas</MudText>
                <MudText Typo="Typo.h5" Style="color:#4caf50; font-weight:700;">
                    @_resumo.TotalReceitas.ToString("C2", _ptBR)
                </MudText>
                <MudText Typo="Typo.caption">@_resumo.Receitas.Count lançamento(s)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2" Style="@($"border-left: 4px solid {(SaldoPositivo ? "#4caf50" : "#f44336")};")">
                <MudText Typo="Typo.caption" Color="Color.Default">Saldo do Mês</MudText>
                <MudText Typo="Typo.h5" Style="@($"color:{(SaldoPositivo ? "#4caf50" : "#f44336")}; font-weight:700;")">
                    @_resumo.Saldo.ToString("C2", _ptBR)
                </MudText>
                <MudText Typo="Typo.caption">receitas - saídas</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2" Style="border-left: 4px solid #2196f3;">
                <MudText Typo="Typo.caption" Color="Color.Default">Contas a Receber</MudText>
                <MudText Typo="Typo.h5" Style="color:#2196f3; font-weight:700;">
                    @_resumo.TotalContasAReceber.ToString("C2", _ptBR)
                </MudText>
                <MudText Typo="Typo.caption">@_resumo.ContasAReceber.Count devedor(es)</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* Despesas Fixas *@
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <div class="d-flex align-center mb-3" style="cursor:pointer;" @onclick="() => _expandFixas = !_expandFixas">
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Error" Class="mr-2" />
            <MudText Typo="Typo.h6" Style="flex:1;">Despesas Fixas — Parcelas do Mês</MudText>
            <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="mr-2">
                @_resumo.TotalDespesasFixas.ToString("C2", _ptBR)
            </MudChip>
            <MudIcon Icon="@(_expandFixas ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
        </div>

        @if (_expandFixas)
        {
            @if (!_resumo.DespesasFixas.Any())
            {
                <MudAlert Severity="Severity.Info" Dense="true">Nenhuma parcela de despesa fixa neste mês.</MudAlert>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true" Striped="true" Style="overflow-x:auto;">
                    <thead>
                        <tr>
                            <th>Descrição</th>
                            <th>Categoria</th>
                            <th>Parcela</th>
                            <th>Vencimento</th>
                            <th style="text-align:right;">Valor</th>
                            <th style="text-align:center;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _resumo.DespesasFixas)
                        {
                            <tr>
                                <td>@item.Descricao</td>
                                <td><span class="mud-chip mud-chip-outlined mud-chip-size-small">@item.Categoria</span></td>
                                <td>@item.NumeroParcela / @item.TotalParcelas</td>
                                <td>@item.DataVencimento.ToString("dd/MM/yyyy")</td>
                                <td style="text-align:right; font-weight:600;">@item.Valor.ToString("C2", _ptBR)</td>
                                <td style="text-align:center;">
                                    @if (item.Paga)
                                    {
                                        <span style="color:#4caf50; font-weight:600;">&#10003; Paga</span>
                                    }
                                    else if (item.DataVencimento < DateOnly.FromDateTime(DateTime.Today))
                                    {
                                        <span style="color:#f44336; font-weight:600;">&#9888; Vencida</span>
                                    }
                                    else
                                    {
                                        <span style="color:#ff9800;">Pendente</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr style="font-weight:700; background:#ffebee;">
                            <td colspan="4" style="text-align:right; padding:6px;">Total</td>
                            <td style="text-align:right; color:#f44336; padding:6px;">@_resumo.TotalDespesasFixas.ToString("C2", _ptBR)</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </MudSimpleTable>
            }
        }
    </MudPaper>

    @* Despesas Extras *@
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <div class="d-flex align-center mb-3" style="cursor:pointer;" @onclick="() => _expandExtras = !_expandExtras">
            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Warning" Class="mr-2" />
            <MudText Typo="Typo.h6" Style="flex:1;">Despesas Extras do Mês</MudText>
            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="mr-2">
                @_resumo.TotalDespesasExtras.ToString("C2", _ptBR)
            </MudChip>
            <MudIcon Icon="@(_expandExtras ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
        </div>

        @if (_expandExtras)
        {
            @if (!_resumo.DespesasExtras.Any())
            {
                <MudAlert Severity="Severity.Info" Dense="true">Nenhuma despesa extra neste mês.</MudAlert>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true" Striped="true" Style="overflow-x:auto;">
                    <thead>
                        <tr>
                            <th>Descrição</th>
                            <th>Categoria</th>
                            <th>Data</th>
                            <th style="text-align:right;">Valor</th>
                            <th style="text-align:center;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _resumo.DespesasExtras)
                        {
                            <tr>
                                <td>@item.Descricao</td>
                                <td><span class="mud-chip mud-chip-outlined mud-chip-size-small">@item.Categoria</span></td>
                                <td>@item.DataDespesa.ToString("dd/MM/yyyy")</td>
                                <td style="text-align:right; font-weight:600;">@item.Valor.ToString("C2", _ptBR)</td>
                                <td style="text-align:center;">
                                    @if (item.Paga)
                                    {
                                        <span style="color:#4caf50; font-weight:600;">&#10003; Paga</span>
                                    }
                                    else
                                    {
                                        <span style="color:#ff9800;">Pendente</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr style="font-weight:700; background:#fff3e0;">
                            <td colspan="3" style="text-align:right; padding:6px;">Total</td>
                            <td style="text-align:right; color:#ff9800; padding:6px;">@_resumo.TotalDespesasExtras.ToString("C2", _ptBR)</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </MudSimpleTable>
            }
        }
    </MudPaper>

    @* Receitas do Mês *@
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <div class="d-flex align-center mb-3" style="cursor:pointer;" @onclick="() => _expandReceitas = !_expandReceitas">
            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Success" Class="mr-2" />
            <MudText Typo="Typo.h6" Style="flex:1;">Receitas do Mês</MudText>
            <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="mr-2">
                @_resumo.TotalReceitas.ToString("C2", _ptBR)
            </MudChip>
            <MudIcon Icon="@(_expandReceitas ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
        </div>

        @if (_expandReceitas)
        {
            @if (!_resumo.Receitas.Any())
            {
                <MudAlert Severity="Severity.Info" Dense="true">Nenhuma receita neste mês.</MudAlert>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true" Striped="true" Style="overflow-x:auto;">
                    <thead>
                        <tr>
                            <th>Descrição</th>
                            <th>Categoria</th>
                            <th>Data</th>
                            <th style="text-align:center;">Recorrente</th>
                            <th style="text-align:right;">Valor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _resumo.Receitas)
                        {
                            <tr>
                                <td>@item.Descricao</td>
                                <td><span class="mud-chip mud-chip-outlined mud-chip-size-small">@item.Categoria</span></td>
                                <td>@item.DataRecebimento.ToString("dd/MM/yyyy")</td>
                                <td style="text-align:center;">
                                    @if (item.Recorrente) { <span style="color:#2196f3;" title="Recorrente">&#8635;</span> }
                                </td>
                                <td style="text-align:right; font-weight:600; color:#4caf50;">@item.Valor.ToString("C2", _ptBR)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr style="font-weight:700; background:#e8f5e9;">
                            <td colspan="4" style="text-align:right; padding:6px;">Total</td>
                            <td style="text-align:right; color:#4caf50; padding:6px;">@_resumo.TotalReceitas.ToString("C2", _ptBR)</td>
                        </tr>
                    </tfoot>
                </MudSimpleTable>
            }
        }
    </MudPaper>

    @* Contas a Receber por Devedor *@
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <div class="d-flex align-center mb-3" style="cursor:pointer;" @onclick="() => _expandReceber = !_expandReceber">
            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Info" Class="mr-2" />
            <MudText Typo="Typo.h6" Style="flex:1;">Contas a Receber por Devedor</MudText>
            <MudChip T="string" Color="Color.Info" Size="Size.Small" Class="mr-2">
                @_resumo.TotalContasAReceber.ToString("C2", _ptBR)
            </MudChip>
            <MudIcon Icon="@(_expandReceber ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
        </div>

        @if (_expandReceber)
        {
            @if (!_resumo.ContasAReceber.Any())
            {
                <MudAlert Severity="Severity.Info" Dense="true">Nenhuma conta a receber neste mês.</MudAlert>
            }
            else
            {
                @foreach (var devedor in _resumo.ContasAReceber)
                {
                    <MudCard Class="mb-3" Outlined="true">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <div class="d-flex align-center">
                                    <MudAvatar Color="Color.Info" Size="Size.Small" Class="mr-2">
                                        @devedor.NomeDevedor[0]
                                    </MudAvatar>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight:600; flex:1;">
                                        @devedor.NomeDevedor
                                    </MudText>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#2196f3;">
                                        @devedor.Total.ToString("C2", _ptBR)
                                    </MudText>
                                </div>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pt-0">
                            <MudSimpleTable Dense="true" Hover="true" Striped="true" Elevation="0" Style="overflow-x:auto;">
                                <thead>
                                    <tr>
                                        <th>Descrição</th>
                                        <th>Parcela</th>
                                        <th>Vencimento</th>
                                        <th style="text-align:right;">Valor</th>
                                        <th style="text-align:center;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var parcelas = devedor.Parcelas; }
                                    @foreach (var p in parcelas)
                                    {
                                        <tr>
                                            <td>@p.Descricao</td>
                                            <td>@p.NumeroParcela / @p.TotalParcelas</td>
                                            <td>@p.DataVencimento.ToString("dd/MM/yyyy")</td>
                                            <td style="text-align:right; font-weight:600;">@p.Valor.ToString("C2", _ptBR)</td>
                                            <td style="text-align:center;">
                                                @if (p.Paga)
                                                {
                                                    <span style="color:#4caf50; font-weight:600;">&#10003; Recebida</span>
                                                }
                                                else if (p.DataVencimento < DateOnly.FromDateTime(DateTime.Today))
                                                {
                                                    <span style="color:#f44336; font-weight:600;">&#9888; Vencida</span>
                                                }
                                                else
                                                {
                                                    <span style="color:#2196f3;">Pendente</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudCardContent>
                    </MudCard>
                }
            }
        }
    </MudPaper>
}

@code {
    private int _anoAtual;
    private int _mesAtual;
    private int _mes;
    private int _ano;
    private int[] _anos = [];

    protected override void OnInitialized()
    {
        _anoAtual = DateTime.Now.Year;
        _mesAtual = DateTime.Now.Month;
        _mes = _mesAtual;
        _ano = _anoAtual;
        _anos = Enumerable.Range(_anoAtual - 3, 7).ToArray();
    }
    private readonly System.Globalization.CultureInfo _ptBR = new("pt-BR");
    private bool _carregando;
    private bool _baixandoPdf;
    private ResumoMensalDto? _resumo;
    private bool SaldoPositivo => _resumo?.Saldo >= 0;

    private decimal TotalAQuitar => _resumo is null ? 0m :
        (_resumo.TotalDespesasFixas + _resumo.TotalDespesasExtras)
        - _resumo.DespesasFixas.Where(d => d.Paga).Sum(d => d.Valor)
        - _resumo.DespesasExtras.Where(d => d.Paga).Sum(d => d.Valor);
    private bool _expandFixas = true;
    private bool _expandExtras = true;
    private bool _expandReceber = true;
    private bool _expandReceitas = true;

    private readonly (int Num, string Nome)[] _meses =
    [
        (1, "Janeiro"), (2, "Fevereiro"), (3, "Março"), (4, "Abril"),
        (5, "Maio"), (6, "Junho"), (7, "Julho"), (8, "Agosto"),
        (9, "Setembro"), (10, "Outubro"), (11, "Novembro"), (12, "Dezembro")
    ];

    protected override async Task OnInitializedAsync() => await Carregar();
    // OnInitialized sets _mes/_ano before OnInitializedAsync runs

    private async Task Carregar()
    {
        _carregando = true;
        try
        {
            _resumo = await Api.ObterResumoMensalAsync(_ano, _mes);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"HTTP {(int?)ex.StatusCode}: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.GetType().Name} — {ex.Message}", Severity.Error);
        }
        finally
        {
            _carregando = false;
        }
    }

    private async Task DownloadPdf()
    {
        _baixandoPdf = true;
        try
        {
            var bytes = await Api.DownloadResumoMensalPdfAsync(_ano, _mes);
            if (bytes is null || bytes.Length == 0)
            {
                Snackbar.Add("Erro ao gerar PDF.", Severity.Error);
                return;
            }
            var nomeMes = _meses.First(m => m.Num == _mes).Nome.ToLower();
            var fileName = $"resumo_{nomeMes}_{_ano}.pdf";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "application/pdf", Convert.ToBase64String(bytes));
        }
        catch
        {
            Snackbar.Add("Erro ao baixar PDF.", Severity.Error);
        }
        finally
        {
            _baixandoPdf = false;
        }
    }
}
